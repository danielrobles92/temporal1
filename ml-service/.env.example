# Copia este archivo a .env y ajusta segun tu entorno.
# Todas las variables usan el prefijo MLSERVICE_.

# Dispositivo de inferencia: cpu | cuda
MLSERVICE_DEVICE=cpu

# Normalizar embeddings con norma L2 (recomendado para similitud del coseno)
MLSERVICE_L2_NORMALIZE=true

# Maximo de imagenes por peticion
MLSERVICE_MAX_BATCH_SIZE=8
